{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "COMSYS",
  "version": "../package.json",
  "identifier": "io.github.sawilove.comsys",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build:native"
  },
  "app": {
    "windows": [
      {
        "title": "COMSYS",
        "width": 1040,
        "height": 720,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": { "debugApplicationIdSuffix": ".preview" },
    "iOS": { "infoPlist": "Info.ios.plist" }
  }
}

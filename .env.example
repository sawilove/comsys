# Скопируй в .env и заполни. Без этих двух строк приложение работает в демо-режиме.
# Project Settings → API в панели Supabase.
VITE_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
VITE_SUPABASE_ANON_KEY=
# Где хранить голосовые: supabase (по умолчанию, 1 ГБ) или b2 (Backblaze, нужна функция media)
VITE_MEDIA_PROVIDER=supabase
